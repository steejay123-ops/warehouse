{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "warehouse-app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "jalali-ts"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4.5mb",
                  "maximumError": "5.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "accounting-only": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.5mb",
                  "maximumError": "4.5mb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "fileReplacements": [
                {
                  "replace": "src/app/modules/warehouse/warehouse.routes.ts",
                  "with": "src/app/modules/warehouse/warehouse.routes.stub.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "warehouse-only": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.5mb",
                  "maximumError": "4.5mb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "fileReplacements": [
                {
                  "replace": "src/app/modules/accounting/accounting.routes.ts",
                  "with": "src/app/modules/accounting/accounting.routes.stub.ts"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "accounting-dev": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                },
                {
                  "replace": "src/app/modules/warehouse/warehouse.routes.ts",
                  "with": "src/app/modules/warehouse/warehouse.routes.stub.ts"
                }
              ]
            },
            "warehouse-dev": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                },
                {
                  "replace": "src/app/modules/accounting/accounting.routes.ts",
                  "with": "src/app/modules/accounting/accounting.routes.stub.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",

          "configurations": {
            "production": {
              "buildTarget": "warehouse-app:build:production"
            },
            "development": {
              "buildTarget": "warehouse-app:build:development"
            },
            "accounting-only": {
              "buildTarget": "warehouse-app:build:accounting-dev"
            },
            "warehouse-only": {
              "buildTarget": "warehouse-app:build:warehouse-dev"
            },
            "accounting-prod": {
              "buildTarget": "warehouse-app:build:accounting-only"
            },
            "warehouse-prod": {
              "buildTarget": "warehouse-app:build:warehouse-only"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
